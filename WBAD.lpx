#!name=WBAD
#!desc=过滤微博广告，并支持新版视频流、广告素材、广告实验和搜索热词独立开关
#!openUrl=https://apps.apple.com/app/id350962117
#!author=RuCu6[https://github.com/RuCu6], zmqcherish[https://github.com/zmqcherish]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/LamontLiao/ADR
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weibo.png
#!date=2026-10-16

[Argument]
blockVideoFlowAds = switch,true,tag=新版视频流广告,desc=过滤 flow_stream 与 flow_stream_cache 中带有明确广告标记的视频
blockAdVideoAssets = switch,false,tag=广告视频素材,desc=默认关闭：该域名也可能承载正常视频，开启可能影响播放
blockAdABTests = switch,false,tag=广告 A/B 实验,desc=默认关闭：修改实验配置可能影响信息流加载，仅供排查使用
blockSearchHotWords = switch,true,tag=搜索热词,desc=清空搜索框、组件和聚合榜单下发的搜索热词

[Rule]
DOMAIN-SUFFIX, uve.weibo.com, DIRECT

DOMAIN, huodong.weibo.cn, REJECT
DOMAIN-SUFFIX, biz.weibo.com, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(?:ug\/checkin\/list|push\/daily|push\/info)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/live\/media_homelist\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/comments\/bullet_screens\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/photo\/info\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_positive|push_info)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/vote\/get_vote_detail\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/chaohua\/discovery\/home_bottom\/switch\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/wbox\/\w+\/(?:home_bottom_modal|interest_category)/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_discover|finder_nav_polling)\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/video\/redpacket\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/(?:search\/finder_nav_polling|sug\/list\/finderchange|was\/finder\/searchbarchange)\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/video\/tiny_video_info_show\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime/i then reject_dict(200)
request if ${url} ~= /^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php)/i then reject_dict(200)

request if ${url} ~= /^https:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead)/i then reject_dict(200)

[Script]
request if ${url} ~= /^https:\/\/ad\.us\.sinaimg\.cn\//i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with tag="拦截广告视频素材", enable=${blockAdVideoAssets}

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/video\/flow_stream(?:_cache)?\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除新版视频流广告", enable=${blockVideoFlowAds}

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/client\/(?:abserver_list|get_grayfeature)\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除广告 A/B 实验", enable=${blockAdABTests}

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(?:search_hot_word|search\/hot_word)\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除搜索热词", enable=${blockSearchHotWords}

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(?:checkin\/show|client\/publisher_list|push\/active)/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除首页推广"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/groups\/allgroups\/v2\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除首页顶部标签"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(?:cardlist|page)/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除信息流广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除评论区广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(?:container\/asyn|flowlist|flowpage)/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除个人微博详情页广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/friendships\/(?:create|destroy)/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除关注、取消关注弹窗"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/profile\/(?:container_timeline|dealatt|me|statuses\/tab|userinfo)/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除个人主页广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/shproxy\/chaohua\/discovery\/searchactive\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除超话搜索页广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:comments_expand_child|container_detail_comment)/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除评论区广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_detail\?|container_timeline(?:_hot|_topic|_topicpage|_unread)?|repost_timeline|unread_hot_timeline)/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除信息流广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:extend|show)\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除微博详情页广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/video\/(?:full_screen_stream|tiny_stream_mid_detail|tiny_stream_video_list)\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除视频流广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/!\/huati\/discovery_home_bottom_channels\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除超话顶部标签"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/direct_messages\/user_list\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除消息页列表广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/messageflow\/notice\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除消息页提醒"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_timeline|finder)\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除热门微博信息流广告"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/searchall\?/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除发现页搜索结果广告"

response if ${url} ~= /^https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除开屏广告 preload"

response if ${url} ~= /^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除开屏广告 sdkad"

response if ${url} ~= /^https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua)/i then script("https://raw.githubusercontent.com/LamontLiao/ADR/main/WBAD.js") with requires_body=true, tag="移除开屏广告 wbapplua"

[MitM]
hostname=*.weibo.cn, *.weibo.com, weibo.com, ad.us.sinaimg.cn

